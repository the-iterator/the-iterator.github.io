@article{cefd6c1df6b24008af3f8db7ccb38370,
  title     = "Classification of electromagnetic resonances in finite inhomogeneous three-dimensional structures",
  abstract  = "We present a simple and unified classification of macroscopic electromagnetic resonances in finite arbitrarily inhomogeneous isotropic dielectric 3D structures situated in free space. By observing the complex-plane dynamics of the spatial spectrum of the volume integral operator as a function of angular frequency and constitutive parameters, we identify and generalize all the usual resonances, including complex plasmons, real laser resonances in media with gain, and real quasistatic resonances in media with negative pertimittivity and gain.",
  keywords  = "CWTS JFIS >= 2.00",
  author    = "NV Budko and AB Samokhin",
  year      = "2006",
  doi       = "doi:10.1103/physrevlett.96.023904",
  language  = "Undefined/Unknown",
  pages     = "023904--1--023904--4",
  journal   = "Physical Review Letters",
  issn      = "0031-9007",
  publisher = "American Physical Society",
},
@article{078ee483befe4ad79efb4f9e0c6eaa71,
  title     = "Spectrum of the volume integral operator of electromagnetic scattering",
  abstract  = "The spectrum of the volume integral operator of three-dimensional electromagnetic scattering is analyzed. The operator has both continuous essential spectrum, which dominates at lower frequencies, and discrete eigenvalues, which spread out at higher ones. The explicit expression of the operator's symbol provides an exact outline of the essential spectrum for any inhomogeneous anisotropic scatterer with Holder continuous constitutive parameters. Geometrical bounds on the location of discrete eigenvalues are derived for various physical scenarios. Numerical experiments demonstrate good agreement between the predicted spectrum of the operator and the eigenvalues of its discretized version.",
  keywords  = "academic journal papers, CWTS JFIS >= 2.00",
  author    = "NV Budko and AB Samokhin",
  year      = "2006",
  doi       = "doi:10.1137/050630660",
